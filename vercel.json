{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "pnpm build",
  "outputDirectory": "public",
  "functions": {
    "api/demo.js": {
      "includeFiles": "ui/**"
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/demo" }]
}
